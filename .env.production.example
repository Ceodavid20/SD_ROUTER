# Launch with SDR_ENV=production and SDR_PROFILE_DIR set to a NEW private directory.
# Copy this file to that directory as .env and chmod 600 it. Do not copy lab .env.
# The process environment takes precedence. dotenv interpolation is disabled.
SDR_AUTH_ENABLED=true
SDR_COOKIE_SECURE=true
SIMULATION_MODE=true
LIVE_ROUTING_ENABLED=false
SDR_ALLOW_PLAINTEXT_API=false

# Replace these example origins and management network with approved values.
SDR_ADMIN_BASE_URL=https://admin.example.test
CONTROLLER_BASE_URL=https://devices.example.test
SDR_ROUTER_ALLOWED_NETWORKS=10.77.0.0/24

# Backends remain local; TLS reverse proxies provide external access.
SDR_ADMIN_HOST=127.0.0.1
SDR_ADMIN_PORT=8000
SDR_ADMIN_TRUSTED_PROXY=127.0.0.1
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=8001
CONTROLLER_TRUSTED_PROXY=127.0.0.1

SDR_ENROLLMENT_ENABLED=false
ROUTER_POLL_INTERVAL=60
SDR_API_TIMEOUT_SECONDS=3
SDR_DISCOVERY_TIMEOUT_SECONDS=15
SDR_DISCOVERY_MAX_AGE_SECONDS=900
SDR_JITTER_INTERVAL_SECONDS=60
SDR_JITTER_API_TIMEOUT_SECONDS=10
SDR_LIVE_SAMPLE_INTERVAL_SECONDS=1
SDR_LIVE_SAMPLE_TIMEOUT_SECONDS=3
SDR_ROUTER_FETCH_TIMEOUT_SECONDS=10
SDR_BOOTSTRAP_TIMEOUT_SECONDS=15
SDR_DASHBOARD_REFRESH_SECONDS=5
SDR_BROWSER_TIMEOUT_SECONDS=10
SDR_SESSION_MINUTES=30

# DATA_DIR, OUTPUT_DIR and credential files default inside SDR_PROFILE_DIR.
# Configure SDR_ROUTER_CA_FILE and SDR_CONTROLLER_CA_FILE with absolute public
# CA paths inside this profile, or use system trust for router API certificates.
# Per-router API CA overrides are also available in Routers.
# Run manage.py configure-admin to generate private admin credentials/session key.
# Never paste router passwords, signing keys or private certificates here as examples.
